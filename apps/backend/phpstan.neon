includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max

    paths:
        - src
        - tests

    excludePaths:
        - src/*/Infrastructure/*/Migrations

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Predis ClientInterface uses __call magic — xadd is defined at runtime
        - '#Call to an undefined method Predis\\ClientInterface::#'
        # PHPStan cannot infer from WebTestCase::getContainer() that the service exists
        - '#Cannot call method (count|getEvents|clear) on object#'

    reportUnmatchedIgnoredErrors: false
