<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Identity\Domain\Model\User" table="users">
        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="email" type="string" column="email" length="254"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="avatarUrl" type="text" column="avatar_url" nullable="true"/>
        <field name="passwordHash" type="text" column="password_hash" nullable="true"/>
        <field name="emailVerified" type="boolean" column="email_verified"/>
        <field name="lastLoginAt" type="datetime_immutable" column="last_login_at" nullable="true"/>
        <field name="timezone" type="string" column="timezone" length="64"/>
        <field name="locale" type="string" column="locale" length="10"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
        <field name="deletedAt" type="datetime_immutable" column="deleted_at" nullable="true"/>
    </entity>
</doctrine-mapping>
