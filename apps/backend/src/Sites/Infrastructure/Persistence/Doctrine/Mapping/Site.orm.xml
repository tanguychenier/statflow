<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Sites\Domain\Model\Site" table="sites">
        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="teamId" type="guid" column="team_id"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="domain" type="string" column="domain" length="253"/>
        <field name="timezone" type="string" column="timezone" length="64"/>
        <field name="trackingEnabled" type="boolean" column="tracking_enabled"/>
        <field name="trackerKey" type="text" column="tracker_key"/>
        <field name="retentionDays" type="integer" column="retention_days" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
        <field name="deletedAt" type="datetime_immutable" column="deleted_at" nullable="true"/>
        <one-to-one field="settings" target-entity="App\Sites\Domain\Model\SiteSettings" mapped-by="site">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-one>
    </entity>
</doctrine-mapping>
