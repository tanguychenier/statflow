# =============================================================================
# Statflow — Environment variable template
#
# Copy this file to .env and fill in the values before running the stack.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All variables documented below are consumed by compose.yaml.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Symfony application environment (dev | test | prod)
APP_ENV=dev

# Cryptographic secret — generate with: openssl rand -hex 32
# Required by Symfony for CSRF tokens, signed URLs, etc.
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Number of FrankenPHP PHP worker processes (default: 4)
# Increase on multi-core machines for higher throughput.
FRANKENPHP_WORKERS=4

# CORS allowed origin for the backend API.
# Dev may use "*" (permissive). In production this MUST be an explicit origin
# such as https://stats.example.com — the prod overlay (compose.prod.yaml) does
# NOT inherit the wildcard and aborts startup if CORS_ALLOW_ORIGIN is unset.
CORS_ALLOW_ORIGIN=*

# ES256 JWT keypair (ADR-0009) and INSTALL_SECRET (ADR-0008) are NOT configured
# here. `make setup` runs scripts/generate-secrets.sh, which provisions them
# into apps/backend/.env.local (gitignored) on first run and never overwrites
# existing keys.

# Dashboard API base URL (used by Vite → import.meta.env.VITE_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:8000

# Dashboard application version string
VITE_APP_VERSION=0.1.0-dev

# ---------------------------------------------------------------------------
# PostgreSQL — application datastore
# ---------------------------------------------------------------------------

POSTGRES_DB=statflow
POSTGRES_USER=statflow

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Host port exposed on the developer workstation
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# ClickHouse — analytical datastore
# ---------------------------------------------------------------------------

CLICKHOUSE_DB=statflow
CLICKHOUSE_USER=statflow

# Generate with: openssl rand -base64 24
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password

# HTTP interface port (used by the backend client and clickhouse-client)
CLICKHOUSE_HTTP_PORT=8123

# Native TCP port (used by the clickhouse-client CLI and some drivers)
CLICKHOUSE_NATIVE_PORT=9000

# ---------------------------------------------------------------------------
# Redis — ingestion buffer + application cache
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_redis_password

REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Exposed ports — change if defaults conflict with local services
# ---------------------------------------------------------------------------

# FrankenPHP backend HTTP port
BACKEND_PORT=8000

# Vite dashboard dev-server port
DASHBOARD_PORT=5173

# ---------------------------------------------------------------------------
# Observability (only active with --profile observability)
# ---------------------------------------------------------------------------

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
