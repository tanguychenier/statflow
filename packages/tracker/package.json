{
  "name": "@statflow/tracker",
  "version": "0.1.0",
  "description": "Privacy-first, cookieless browser tracker for the Statflow analytics platform.",
  "author": "Tanguy Chénier",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/tracker.global.js",
  "module": "./dist/tracker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tracker.js",
      "require": "./dist/tracker.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "stryker": "stryker run"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "size-limit": [
    {
      "name": "tracker — core init() entry point (pageview + SPA + transport)",
      "path": "dist/tracker.js",
      "limit": "4300 B",
      "gzip": true,
      "brotli": false,
      "import": "{ init }"
    },
    {
      "name": "behavior — lazily-loaded behavioral collectors",
      "path": "dist/behavior.js",
      "limit": "6144 B",
      "gzip": true,
      "brotli": false,
      "import": "{ mount }"
    },
    {
      "name": "tracker-heatmap — lazily-loaded heatmap bundle",
      "path": "dist/tracker-heatmap.js",
      "limit": "4096 B",
      "gzip": true,
      "brotli": false,
      "import": "{ init }"
    }
  ]
}
